{
  "name": "mobilidade-urbana",
  "version": "0.2.0",
  "description": "Mobilidade Urbana — Sprint 2 (API Node.js + app React Native/Expo para Android)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:reset": "node scripts/db.mjs reset",
    "seed": "npm --prefix backend run seed",
    "certs": "npm --prefix backend run certs --",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --prefix backend run dev",
    "dev:app": "npm --prefix mobile start",
    "dev:android": "node scripts/dev.mjs --android",
    "web": "npm --prefix mobile run web",
    "android": "node scripts/android.mjs tudo",
    "android:apk": "node scripts/android.mjs apk",
    "android:emulador": "node scripts/android.mjs emulador",
    "android:instalar": "node scripts/android.mjs instalar",
    "lint": "npm --prefix backend run lint && npm --prefix mobile run lint",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix mobile run typecheck",
    "test": "npm run test:backend && npm run test:mobile",
    "test:backend": "npm --prefix backend test --",
    "test:mobile": "npm --prefix mobile test --",
    "test:e2e": "npm --prefix e2e test --",
    "check": "npm run lint && npm run typecheck && npm test",
    "build": "npm --prefix backend run build && npm --prefix mobile run export:web",
    "video": "npm --prefix e2e run video",
    "verify": "node scripts/verify.mjs",
    "backup": "node scripts/backup.mjs backup",
    "backup:list": "node scripts/backup.mjs list",
    "restore": "node scripts/backup.mjs restore"
  }
}
