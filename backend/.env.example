# Copiado para .env pelo "npm run setup" (na raiz). Ajuste se precisar.
NODE_ENV=development

# HTTP (app em desenvolvimento / emulador) e HTTPS (US13, certificado gerado por "npm run certs")
PORT=3333
HTTPS_PORT=3443
TLS_CERT_FILE=./certs/dev-cert.pem
TLS_KEY_FILE=./certs/dev-key.pem
# true = todo acesso HTTP é redirecionado para HTTPS (padrão em produção)
FORCE_HTTPS=false

# PostgreSQL do docker-compose (porta 5434 para não conflitar com um PostgreSQL já instalado)
DATABASE_URL=postgres://dmr:dmr@localhost:5434/dmr
# Banco usado pelos testes automatizados
TEST_DATABASE_URL=postgres://dmr:dmr@localhost:5434/dmr_test

# Segredo dos tokens de login (32+ caracteres). OBRIGATÓRIO trocar em produção.
JWT_SECRET=dev-troque-este-segredo-com-32-caracteres-ou-mais

# US03 — página aberta pelo link do e-mail de redefinição de senha
#   app no navegador:          http://localhost:8081/reset-password
#   app instalado (deep link): mobilidade://reset-password
PUBLIC_APP_URL=http://localhost:8081/reset-password

# SMTP real (ex.: smtp://usuario:senha@smtp.gmail.com:587).
# Vazio = os e-mails ficam na caixa de desenvolvimento: http://localhost:3333/dev/emails
SMTP_URL=
MAIL_FROM="Mobilidade Urbana <nao-responda@mobilidade.app>"

# Quantos proxies (Nginx, Caddy, balanceador) ficam na frente da API. 0 = acesso direto.
# Só com proxy a API aceita X-Forwarded-For/Proto (senão o IP do limite de tentativas poderia ser forjado).
TRUST_PROXY=0

# Origens liberadas no CORS (* em desenvolvimento; em produção, o domínio do app)
CORS_ORIGINS=*
